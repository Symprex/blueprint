<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Marten" Version="6.4.2" />
        <!-- Marten 6.4.2 pulls in Npgsql 7.0.6 (via Npgsql.Json.NET), which carries a known high
             severity vulnerability (GHSA-x9vc-6hfv-hg8c). Pinned explicitly to the first patched
             7.x release to clear it. -->
        <PackageReference Include="Npgsql" Version="7.0.7" />
        <PackageReference Include="OpenTelemetry.Api" Version="1.15.3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Blueprint.Runtime.Model\Blueprint.Runtime.Model.csproj" />
        <ProjectReference Include="..\Blueprint.Runtime\Blueprint.Runtime.csproj" />
    </ItemGroup>

</Project>

