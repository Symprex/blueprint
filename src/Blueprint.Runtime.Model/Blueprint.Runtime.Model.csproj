<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Contracts for Blueprint APIs: operations (ICommand, IQuery), BlueprintApp, ApiResource, Results&lt;T1, T2&gt; and the attributes that describe routes, links, binding and authorisation.</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Blueprint.Model</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2024.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- RecurringTaskManager gives each collected schedule its legacy id through an internal constructor, so that the id
         is not settable by anyone else. -->
    <InternalsVisibleTo Include="Blueprint.Runtime" />
  </ItemGroup>

</Project>

