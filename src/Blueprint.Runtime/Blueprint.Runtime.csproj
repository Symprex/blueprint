<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>The Blueprint runtime: executes source-generated operation pipelines, maps them to ASP.NET Core endpoints, translates results to HTTP responses and serves the generated OpenAPI document.</Description>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- The client reads a resource event as legacy did, setting the properties the host alone sets otherwise. -->
    <InternalsVisibleTo Include="Blueprint.HttpClient" />
    <InternalsVisibleTo Include="Blueprint.SourceGenerator.Benchmarks" />
    <InternalsVisibleTo Include="Blueprint.SourceGenerator.Tests.Integration" />

    <!-- The upstream stub writes problems and 422s with the host's own naming and fallback, so a stub answers as a host does. -->
    <InternalsVisibleTo Include="Blueprint.Testing.HttpClient" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2024.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blueprint.Runtime.Model\Blueprint.Runtime.Model.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The BlueprintEmitOpenApi build target, imported by every project that consumes the package, directly or not. -->
    <None Include="buildTransitive\Blueprint.Runtime.targets" Pack="true" PackagePath="buildTransitive\Blueprint.Runtime.targets" />
  </ItemGroup>
</Project>
