<Project Sdk="Microsoft.NET.Sdk">

  <!--
    An upstream service's contract, as a gateway in Blueprint.SourceGenerator.Tests.Integration exposes it: operations in
    another assembly, documented only in this assembly's XML documentation file. Nothing hosts them, so they have no
    handlers.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blueprint.Runtime.Model\Blueprint.Runtime.Model.csproj" />
    <ProjectReference Include="..\Blueprint.Runtime\Blueprint.Runtime.csproj" />
    <ProjectReference Include="..\Blueprint.SourceGenerator\Blueprint.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Blueprint.SourceGenerator.CodeFixes\Blueprint.SourceGenerator.CodeFixes.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
